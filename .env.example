OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.3-flash
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/podcast_reconciliation
API_PORT=4010
NEXT_PUBLIC_API_BASE_URL=http://localhost:4010
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
RSS_SYNC_INTERVAL_MINUTES=60
# Invoice email delivery (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=billing@example.com
# Providers to route away from (comma-separated OpenRouter provider slugs).
OPENROUTER_IGNORE_PROVIDERS=z-ai,novita,gmicloud
